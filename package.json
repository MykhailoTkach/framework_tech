{
  "name": "book_catalog",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "imports": {
    "#config": "./config/config.js",
    "#logger": "./logger.js",
    "#constants": "./constants/index.js",
    "#controllers": "./controllers/books.controller.js",
    "#routes": "./routes/router.js",
    "#schemas": "./schemas/index.js",
    "#data": "./data/books.data.js",
    "#utils/send": "./utils/send.js",
    "#utils/getBody": "./utils/getBody.js",
    "#utils/parseUrl": "./utils/parseUrl.js"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch --env-file=.env server.js",
    "dev:debug": "node --env-file=.env server.js",
    "seed": "node src/scripts/seed.js",
    "seed:force": "node src/scripts/seed.js --force",
    "migrate": "node src/migrations/migrate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "predev": "npm run check",
    "external": "json-server db.json --port 3001",
    "db:init": "node db/init.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MykhailoTkach/framework_tech.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MykhailoTkach/framework_tech/issues"
  },
  "homepage": "https://github.com/MykhailoTkach/framework_tech#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "json-server": "^1.0.0-beta.15",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "ajv": "^8.18.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "mysql2": "^3.22.3"
  }
}
